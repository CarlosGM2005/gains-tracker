rules_version = '2';

// Reglas de GainsTracker (reconstrucción v2). Compatibles también con los datos y la app antigua.
// Probar primero con `firebase emulators:start --only auth,firestore`.
// Desplegar (lo hace el usuario): `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function textoONull(valor) {
      return valor == null || valor is string;
    }

    function numeroONull(valor) {
      return valor == null || valor is number;
    }

    // Catálogo: lectura pública (invitados incluidos). Se carga a mano desde la consola.
    match /ejercicios/{ejercicioId} {
      allow read: if true;
      allow write: if false;
    }

    match /usuarios/{uid} {
      // Foto de perfil (fase 8): data URL WebP/JPEG pequeño dentro del propio documento, sin Storage.
      // Mismo límite que REGLAS_FOTO en src/app/features/perfil/domain/perfil.rules.ts.
      function fotoValida(valor) {
        return valor == null
          || (valor is string && valor.size() <= 150000 && valor.matches('^data:image/(webp|jpeg);base64,.+$'));
      }

      // Favoritos (fase 8): ids de ejercicios.
      function favoritosValidos(valor) {
        return valor is list && valor.size() <= 500;
      }

      function perfilValido(datos) {
        return datos.keys().hasOnly(['uid', 'nombre', 'email', 'telefono', 'edad', 'peso', 'altura', 'createdAt', 'foto', 'favoritos'])
          && datos.uid == uid
          && datos.nombre is string && datos.nombre.size() <= 80
          && datos.email is string
          && textoONull(datos.telefono)
          && numeroONull(datos.edad)
          && numeroONull(datos.peso)
          && numeroONull(datos.altura)
          && fotoValida(datos.get('foto', null))
          && favoritosValidos(datos.get('favoritos', []));
      }

      allow read: if esDueno(uid);
      allow create: if esDueno(uid) && perfilValido(request.resource.data);
      allow update: if esDueno(uid)
        && perfilValido(request.resource.data)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      // Eliminar cuenta (fase 8): el propio usuario borra su perfil.
      allow delete: if esDueno(uid);

      // Un documento por ejercicio con el array `series`.
      match /registros/{ejercicioId} {
        allow read: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && request.resource.data.keys().hasOnly(['id', 'nombre', 'imagen', 'series', 'isOpen'])
          && request.resource.data.id == ejercicioId
          && request.resource.data.series is list
          && request.resource.data.series.size() <= 5000;
        // Borrar la última serie de un ejercicio o eliminar la cuenta (fase 8).
        allow delete: if esDueno(uid);
      }
    }
  }
}
